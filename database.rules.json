{
  "rules": {
    "users": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN' || root.child('users').child(auth.uid).child('role').val() == 'Owner' || root.child('users').child(auth.uid).child('role').val() == 'OWNER')",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN')"
      }
    },
    "tourist_users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN' || root.child('users').child(auth.uid).child('role').val() == 'Owner' || root.child('users').child(auth.uid).child('role').val() == 'OWNER')"
      }
    },
    "properties": {
      ".read": "true",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN') && root.child('users').child(auth.uid).child('isBanned').val() != true"
      }
    },
    "bookings": {
      ".read": "auth != null",
      ".indexOn": ["activityId", "ownerUid", "touristUid", "importBatchId", "roomId"],
      "$bookingId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN' || (root.child('users').child(auth.uid).child('isBanned').val() != true && ((data.exists() && (data.child('touristUid').val() == auth.uid || data.child('ownerUid').val() == auth.uid)) || (!data.exists() && (newData.child('touristUid').val() == auth.uid || (newData.child('isHistorical').val() == true && newData.child('ownerUid').val() == auth.uid && root.child('properties').child(auth.uid).exists()))))))"
      }
    },
    "payments": {
      ".read": "auth != null",
      ".indexOn": ["bookingId"]
    },
    "reviews": {
      ".read": "true",
      "$ownerUid": {
        "$reviewId": {
          ".write": "auth != null && (auth.uid == $ownerUid || auth.uid == newData.child('touristUid').val() || auth.uid == data.child('touristUid').val() || root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN') && root.child('users').child(auth.uid).child('isBanned').val() != true"
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$notificationId": {
          ".write": "auth != null && (auth.uid == $uid || (!data.exists() && root.child('users').child(auth.uid).child('isBanned').val() != true))"
        }
      }
    },
    "chat_rooms": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$otherUid": {
          ".read": "auth != null && (auth.uid == $uid || auth.uid == $otherUid || root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN')",
          ".write": "auth != null && (auth.uid == $uid || auth.uid == $otherUid || root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN') && root.child('users').child(auth.uid).child('isBanned').val() != true"
        }
      }
    },
    "chats": {
      "$chatId": {
        ".indexOn": ["timestamp"],
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN' || $chatId.contains(auth.uid))",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN' || ($chatId.contains(auth.uid) && root.child('users').child(auth.uid).child('isBanned').val() != true))"
      }
    },
    "reports": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN')",
      ".indexOn": ["status"],
      ".write": "auth != null && root.child('users').child(auth.uid).child('isBanned').val() != true"
    },
    "activities": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN') && root.child('users').child(auth.uid).child('isBanned').val() != true"
      }
    },
    "blocks": {
      "$uid": {
        ".read": "auth != null",
        "$blockedUid": {
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },
    "cms": {
      ".read": "true",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN')"
    },
    "user_coupons": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN')",
        "$couponId": {
          ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN') && root.child('users').child(auth.uid).child('isBanned').val() != true"
        }
      }
    },
    "used_receipts": {
      "$ownerUid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $ownerUid || root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN' || (newData.exists() && root.child('users').child(auth.uid).child('isBanned').val() != true))"
      }
    },
    "id_registry": {
      ".read": "true",
      "$idHash": {
        ".write": "auth != null && (!data.exists() || data.val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN')"
      }
    },
    "room_service_orders": {
      ".read": "auth != null",
      "$orderId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN' || (!data.exists() && root.child('users').child(auth.uid).child('isBanned').val() != true) || (data.exists() && (data.child('ownerUid').val() == auth.uid || root.child('bookings').child(data.child('bookingId').val()).child('touristUid').val() == auth.uid)))"
      }
    },
    "revenue_reports": {
      "$ownerUid": {
        ".read": "auth != null && (auth.uid == $ownerUid || root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN')",
        ".write": "auth != null && (auth.uid == $ownerUid || root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN') && root.child('users').child(auth.uid).child('isBanned').val() != true"
      }
    },
    "owner_stats": {
      "$ownerUid": {
        ".read": "auth != null && (auth.uid == $ownerUid || root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN')",
        ".write": "auth != null && (auth.uid == $ownerUid || root.child('users').child(auth.uid).child('role').val() == 'Admin' || root.child('users').child(auth.uid).child('role').val() == 'ADMIN') && root.child('users').child(auth.uid).child('isBanned').val() != true"
      }
    }
  }
}
